<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Die getesteten Dateien direkt einbinden. Nur Anordnung und BPMN-Export brauchen WPF-Grundtypen (Point/Rect). -->
  <ItemGroup>
    <Compile Include="..\..\src\Folio\Diagrams\FlowLayout.cs" Link="Src\FlowLayout.cs" />
    <Compile Include="..\..\src\Folio\Diagrams\BpmnExport.cs" Link="Src\BpmnExport.cs" />
    <Compile Include="..\..\src\Folio\Editor\MarkdownAnalysis.cs" Link="Src\MarkdownAnalysis.cs" />
    <Compile Include="..\..\src\Folio\Services\TextFiles.cs" Link="Src\TextFiles.cs" />
    <Compile Include="..\..\src\Folio\Diagrams\Durations.cs" Link="Src\Durations.cs" />
    <Compile Include="..\..\src\Folio\Diagrams\DiagramModel.cs" Link="Src\DiagramModel.cs" />
    <Compile Include="..\..\src\Folio\Diagrams\MermaidParser.cs" Link="Src\MermaidParser.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.0" />
  </ItemGroup>

</Project>
